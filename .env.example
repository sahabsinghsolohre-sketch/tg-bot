# Copy this file to ".env" and paste your real values.
# The .env file is git-ignored so your secrets stay private.

# --- Telegram ---
BOT_TOKEN=your-token-here
SUPPORT_CONTACT=@your_support_username

# --- Database ---
# Leave blank to use local SQLite (bot.db).
# Paste your Neon PostgreSQL URL here for cloud hosting (e.g. postgresql://user:pass@ep-xyz.neon.tech/neondb?sslmode=require)
DATABASE_URL=


# --- Admin Settings ---
# Telegram Numeric User ID of the admin (get yours from @userinfobot on Telegram).
# Multiple admin IDs can be separated by commas (e.g. ADMIN_ID=123456789,987654321).
ADMIN_ID=123456789

# --- BEP20 (Binance Smart Chain) crypto deposits ---
# Your PUBLIC receiving wallet address (starts with 0x). NEVER put a private key/seed here.
BEP20_ADDRESS=0xYourBep20WalletAddressHere
# Free API key from https://bscscan.com/apis
BSCSCAN_API_KEY=your-bscscan-api-key
# Minutes a deposit request stays valid before it expires.
DEPOSIT_WINDOW_MINUTES=30
